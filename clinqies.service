[Unit]
Description=clinqies.xyz file server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/clinqies/backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clinqies

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/clinqies/data /var/www/clinqies/uploads

[Install]
WantedBy=multi-user.target
